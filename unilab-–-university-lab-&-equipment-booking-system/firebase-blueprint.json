{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role and department assignment",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["STUDENT", "FACULTY", "LAB_STAFF", "COORDINATOR", "ADMIN"] },
        "departmentId": { "type": "string", "maxLength": 100 },
        "departmentName": { "type": "string", "maxLength": 100 },
        "studentId": { "type": "string", "maxLength": 50 },
        "employeeId": { "type": "string", "maxLength": 50 },
        "phone": { "type": "string", "maxLength": 30 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "email", "role", "active"]
    },
    "Department": {
      "title": "Department",
      "description": "Academic department",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 100 },
        "code": { "type": "string", "maxLength": 20 },
        "headName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "code"]
    },
    "Lab": {
      "title": "Lab",
      "description": "Laboratory facility available for booking",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "labId": { "type": "string", "maxLength": 50 },
        "name": { "type": "string", "maxLength": 150 },
        "departmentId": { "type": "string", "maxLength": 100 },
        "departmentName": { "type": "string", "maxLength": 100 },
        "capacity": { "type": "number" },
        "location": { "type": "string", "maxLength": 150 },
        "facilities": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["AVAILABLE", "RESERVED", "IN_USE", "MAINTENANCE", "CLOSED"] },
        "description": { "type": "string", "maxLength": 1000 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "labId", "name", "departmentId", "capacity", "location", "status"]
    },
    "EquipmentCategory": {
      "title": "EquipmentCategory",
      "description": "Category classification for equipment items",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "icon": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name"]
    },
    "Equipment": {
      "title": "Equipment",
      "description": "Physical lab equipment item and stock tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "equipmentId": { "type": "string", "maxLength": 50 },
        "name": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 100 },
        "labId": { "type": "string", "maxLength": 100 },
        "labName": { "type": "string", "maxLength": 150 },
        "departmentId": { "type": "string", "maxLength": 100 },
        "totalQuantity": { "type": "number" },
        "availableQuantity": { "type": "number" },
        "reservedQuantity": { "type": "number" },
        "inUseQuantity": { "type": "number" },
        "condition": { "type": "string", "enum": ["EXCELLENT", "GOOD", "FAIR", "NEEDS_REPAIR", "DECOMMISSIONED"] },
        "maintenanceStatus": { "type": "string", "enum": ["OPERATIONAL", "UNDER_MAINTENANCE", "CALIBRATION_DUE"] },
        "description": { "type": "string", "maxLength": 1000 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "equipmentId", "name", "category", "labId", "totalQuantity", "availableQuantity"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Lab or equipment booking reservation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "bookingId": { "type": "string", "maxLength": 50 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userEmail": { "type": "string", "maxLength": 150 },
        "userRole": { "type": "string", "maxLength": 50 },
        "departmentId": { "type": "string", "maxLength": 100 },
        "resourceType": { "type": "string", "enum": ["LAB", "EQUIPMENT"] },
        "resourceId": { "type": "string", "maxLength": 100 },
        "resourceName": { "type": "string", "maxLength": 150 },
        "bookingDate": { "type": "string", "maxLength": 20 },
        "startTime": { "type": "string", "maxLength": 10 },
        "endTime": { "type": "string", "maxLength": 10 },
        "quantity": { "type": "number" },
        "purpose": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["DRAFT", "PENDING_APPROVAL", "APPROVED", "RESERVED", "IN_USE", "COMPLETED", "REJECTED", "CANCELLED", "OVERDUE", "RETURNED_LATE", "DAMAGED"] },
        "approvalStatus": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "bookingStatus": { "type": "string", "maxLength": 50 },
        "rejectionReason": { "type": "string", "maxLength": 500 },
        "approvedBy": { "type": "string", "maxLength": 128 },
        "approvedByName": { "type": "string", "maxLength": 100 },
        "approvedAt": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "bookingId", "userId", "resourceType", "resourceId", "resourceName", "bookingDate", "startTime", "endTime", "quantity", "status", "approvalStatus"]
    },
    "Issue": {
      "title": "Issue",
      "description": "Physical issue and return log for equipment",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "issueId": { "type": "string", "maxLength": 50 },
        "bookingId": { "type": "string", "maxLength": 100 },
        "equipmentId": { "type": "string", "maxLength": 100 },
        "equipmentName": { "type": "string", "maxLength": 150 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "issuedBy": { "type": "string", "maxLength": 128 },
        "issuedByName": { "type": "string", "maxLength": 100 },
        "quantity": { "type": "number" },
        "issuedAt": { "type": "string", "maxLength": 50 },
        "expectedReturnAt": { "type": "string", "maxLength": 50 },
        "actualReturnAt": { "type": "string", "maxLength": 50 },
        "returnCondition": { "type": "string", "enum": ["EXCELLENT", "GOOD", "FAIR", "DAMAGED", "MISSING"] },
        "damageReport": { "type": "string", "maxLength": 1000 },
        "missingQuantity": { "type": "number" },
        "remarks": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["ISSUED", "RETURNED", "RETURNED_LATE", "DAMAGED", "OVERDUE"] }
      },
      "required": ["id", "issueId", "bookingId", "equipmentId", "userId", "quantity", "issuedAt", "expectedReturnAt", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notifications for booking status, issues, and alerts",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 500 },
        "type": { "type": "string", "enum": ["INFO", "SUCCESS", "WARNING", "ALERT"] },
        "read": { "type": "boolean" },
        "relatedBookingId": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "title", "message", "type", "read"]
    },
    "Maintenance": {
      "title": "Maintenance",
      "description": "Maintenance record for labs or equipment",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "resourceType": { "type": "string", "enum": ["LAB", "EQUIPMENT"] },
        "resourceId": { "type": "string", "maxLength": 100 },
        "resourceName": { "type": "string", "maxLength": 150 },
        "type": { "type": "string", "enum": ["ROUTINE", "REPAIR", "CALIBRATION", "EMERGENCY"] },
        "description": { "type": "string", "maxLength": 1000 },
        "scheduledDate": { "type": "string", "maxLength": 50 },
        "completedDate": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["SCHEDULED", "IN_PROGRESS", "COMPLETED", "CANCELLED"] },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdByName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "resourceType", "resourceId", "type", "description", "status"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System audit trail for actions and security monitoring",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userRole": { "type": "string", "maxLength": 50 },
        "action": { "type": "string", "maxLength": 100 },
        "entityType": { "type": "string", "maxLength": 50 },
        "entityId": { "type": "string", "maxLength": 100 },
        "details": { "type": "string", "maxLength": 1000 },
        "timestamp": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "action", "entityType", "entityId", "timestamp"]
    },
    "SystemSetting": {
      "title": "SystemSetting",
      "description": "Booking rules and global university configurations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "maxBookingDurationHours": { "type": "number" },
        "maxActiveBookingsPerUser": { "type": "number" },
        "maxEquipmentQuantityPerBooking": { "type": "number" },
        "minAdvanceBookingHours": { "type": "number" },
        "cancellationDeadlineHours": { "type": "number" },
        "allowCrossDepartmentBooking": { "type": "boolean" },
        "autoApprovalForFaculty": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 50 },
        "updatedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles and credentials"
    },
    "/departments/{departmentId}": {
      "schema": { "$ref": "#/entities/Department" },
      "description": "University departments"
    },
    "/labs/{labId}": {
      "schema": { "$ref": "#/entities/Lab" },
      "description": "Laboratories available for booking"
    },
    "/equipmentCategories/{categoryId}": {
      "schema": { "$ref": "#/entities/EquipmentCategory" },
      "description": "Equipment categories"
    },
    "/equipment/{equipmentId}": {
      "schema": { "$ref": "#/entities/Equipment" },
      "description": "Equipment inventory items"
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Lab and equipment bookings"
    },
    "/issues/{issueId}": {
      "schema": { "$ref": "#/entities/Issue" },
      "description": "Equipment issue and return records"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "In-app notifications"
    },
    "/maintenance/{maintenanceId}": {
      "schema": { "$ref": "#/entities/Maintenance" },
      "description": "Maintenance tracking records"
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Audit trail log records"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/SystemSetting" },
      "description": "Global university booking policies and rules"
    }
  }
}
